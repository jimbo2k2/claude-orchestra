#!/bin/bash
# orchestra — CLI for managing autonomous Claude Code workflows.
# Spec: docs/superpowers/specs/2026-04-29-orchestra-cleanup-design.md
#
# Subcommands:
#   init     — Scaffold .orchestra/ in current dir
#   run      — Start an orchestra run
#   status   — Show current run state
#   test     — Run smoke test
#   reset    — Archive in-progress run state and reset
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"

usage() {
    cat <<EOF
Usage: orchestra <command> [args]

Commands:
  init [dir]    Scaffold .orchestra/ state files in target directory
  run           Start an orchestra run (uses .orchestra/CONFIG.md + OBJECTIVE.md)
  status        Show current run state
  test          Run end-to-end smoke test
  reset         Archive current run state, reset for next
  cold-store    Mothball runs/<ts>/ and runs/archive/<ts>/ folders to
                .orchestra/cold-storage/<ts>-<slug>/ with a slug derived
                from each run's 2-OBJECTIVE.md. Refuses if any orchestra
                tmux session is active. See MIGRATION-run-in-place.md.

All run parameters live in .orchestra/CONFIG.md — no env vars, no CLI args.
EOF
}

# Slugify a run's 2-OBJECTIVE.md into a folder-name-safe slug.
# Rules (per the cold-store convention):
#   1. Read the first non-empty line.
#   2. Strip leading '#' marks and a 'Run Objective' / 'Objective' prefix
#      (with any trailing em-dash, en-dash, hyphen, or colon separator).
#   3. Lowercase. Replace runs of non-[a-z0-9] with a single hyphen.
#      Strip leading and trailing hyphens.
#   4. Truncate to ≤60 chars; if truncation lands mid-word, back up to the
#      last hyphen boundary.
# Returns the slug on stdout (empty string if the file is missing or yields
# nothing).
_slugify_objective() {
    local file="$1"
    [ -f "$file" ] || { echo ""; return 0; }
    local line
    line=$(awk 'NF { print; exit }' "$file" 2>/dev/null) || true
    [ -n "$line" ] || { echo ""; return 0; }
    line=$(printf '%s' "$line" | sed -E 's/^#+[[:space:]]*//; s/^([Rr]un [Oo]bjective|[Oo]bjective)[[:space:]]*[-—–:][[:space:]]*//')
    line=$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
    if [ ${#line} -gt 60 ]; then
        line="${line:0:60}"
        # Back up to last hyphen unless that wipes the whole string.
        if [[ "$line" == *-* ]]; then
            line="${line%-*}"
        fi
    fi
    printf '%s' "$line"
}

cmd_cold_store() {
    local project_dir
    project_dir="$(git rev-parse --show-toplevel 2>/dev/null)" || die "Not in a git repository"
    local orch="$project_dir/.orchestra"
    [ -d "$orch" ] || die ".orchestra/ not found. Run 'orchestra init' first."

    declare -gA ORCHESTRA_CONFIG
    # shellcheck source=/dev/null
    source "$orch/runtime/lib/config.sh"
    parse_config_md "$orch/CONFIG.md" || die "CONFIG.md parse failed"
    apply_config_defaults

    local tmux_prefix="${ORCHESTRA_CONFIG[TMUX_PREFIX]}"

    # Refuse if any tmux session matching <TMUX_PREFIX>-* is alive — that
    # means an orchestra run is in progress and we'd race against wind-down.
    if tmux ls 2>/dev/null | grep -qE "^${tmux_prefix}-"; then
        die "Refusing to cold-store while an orchestra run is active (tmux session '${tmux_prefix}-*' exists)."
    fi

    local cold_dir="$orch/cold-storage"
    mkdir -p "$cold_dir"

    local moved=0
    local run ts slug dest

    # Sources: active runs (runs/<ts>/) + archived runs (runs/archive/<ts>/).
    # Move both to cold-storage/<ts>-<slug>/.
    for src_root in "$orch/runs" "$orch/runs/archive"; do
        [ -d "$src_root" ] || continue
        while IFS= read -r run; do
            [ -n "$run" ] || continue
            ts="$(basename "$run")"
            # Skip archive/ itself (depth-1 of runs/) — it isn't a run folder.
            [ "$ts" = "archive" ] && continue
            slug=$(_slugify_objective "$run/2-OBJECTIVE.md")
            if [ -n "$slug" ]; then
                dest="$cold_dir/${ts}-${slug}"
            else
                dest="$cold_dir/${ts}"
            fi
            # If the destination already exists (rare — would mean a duplicate
            # ts+slug across active/archive), append a `-dup` suffix.
            if [ -e "$dest" ]; then
                dest="${dest}-dup"
            fi
            # Prefer 'git mv' so the move is staged + traceable. Fall back to
            # plain 'mv' for files not tracked in git (e.g. fresh init in a
            # repo without these runs committed).
            if git -C "$project_dir" ls-files --error-unmatch "$run" >/dev/null 2>&1; then
                git -C "$project_dir" mv "$run" "$dest"
            else
                mv "$run" "$dest"
            fi
            moved=$((moved + 1))
        done < <(find "$src_root" -mindepth 1 -maxdepth 1 -type d -not -name archive 2>/dev/null)
    done

    # Remove the now-empty runs/archive/ directory (best effort).
    rmdir "$orch/runs/archive" 2>/dev/null || true

    echo "Cold-storage: $moved run folder(s) moved to .orchestra/cold-storage/"
    echo ""
    echo "Review and commit with something like:"
    echo "  git -C $project_dir add .orchestra/"
    echo "  git -C $project_dir commit -m 'orchestra: cold-store $moved historical run folders'"
}

die() { echo "ERROR: $1" >&2; exit 1; }

cmd_init() {
    local target="${1:-.}"
    target="$(cd "$target" 2>/dev/null && pwd)" || die "Directory does not exist: ${1:-.}"

    # Must be a git repo (no auto-init per spec Section 12 step 2)
    git -C "$target" rev-parse --show-toplevel >/dev/null 2>&1 \
        || die "$target is not a git repository. If this is intentional, run 'git init' first then retry."

    # inotify-tools preflight (Linux-only target per spec Section 11.C)
    command -v inotifywait >/dev/null 2>&1 \
        || die "inotify-tools not installed — run 'apt-get install inotify-tools' (Ubuntu/Debian) or your distro's equivalent"

    local orch="$target/.orchestra"
    mkdir -p "$orch/runtime/bin" "$orch/runtime/lib" "$orch/runs/archive"

    # Copy runtime files. Source paths relative to this script's location.
    cp "$SCRIPT_DIR/orchestra"          "$orch/runtime/bin/orchestra"
    chmod +x "$orch/runtime/bin/orchestra"
    # orchestrator.sh is added in Phase 4; copy if it exists, otherwise skip silently
    if [ -f "$SCRIPT_DIR/orchestrator.sh" ]; then
        cp "$SCRIPT_DIR/orchestrator.sh" "$orch/runtime/bin/orchestrator.sh"
        chmod +x "$orch/runtime/bin/orchestrator.sh"
    fi
    cp "$LIB_DIR/config.sh" "$orch/runtime/lib/config.sh"
    cp "$LIB_DIR/winddown-prompt.txt" "$orch/runtime/lib/winddown-prompt.txt"
    cp "$LIB_DIR/organiser-prompt.txt" "$orch/runtime/lib/organiser-prompt.txt"
    cp "$LIB_DIR/executor-prompt-template.txt" "$orch/runtime/lib/executor-prompt-template.txt"

    # Copy templates only if missing — never overwrite user content.
    # Each entry: "<template-filename>:<dest-filename>". Most are identity;
    # orchestra-CLAUDE.md is renamed to CLAUDE.md so the source template
    # filename doesn't collide with the project's own CLAUDE.md template.
    local TEMPLATE_DIR="$SCRIPT_DIR/../templates"
    for pair in "CONFIG.md:CONFIG.md" "OBJECTIVE.md:OBJECTIVE.md" "orchestra-CLAUDE.md:CLAUDE.md"; do
        local src="${pair%:*}" dst="${pair#*:}"
        if [ ! -f "$orch/$dst" ]; then
            # CONFIG.md needs __WORKTREE_PATH__ substituted with the resolved
            # target dir. Other templates have no substitutions today; sed pass
            # is a no-op for them.
            sed "s|__WORKTREE_PATH__|$target|g" "$TEMPLATE_DIR/$src" > "$orch/$dst"
            echo "  Created .orchestra/$dst"
        else
            echo "  Skipped .orchestra/$dst (already exists)"
        fi
    done

    cat <<EOF

Done. Next steps:
  1. Review .orchestra/CONFIG.md — WORKTREE_PATH is pre-filled to $target.
     Set MAX_SESSIONS and ORGANISER_MODEL if defaults don't suit.
     Extend PROTECTED_BRANCHES if your primary branch isn't main/master.
  2. Edit .orchestra/OBJECTIVE.md with the brief for your first run
  3. Commit .orchestra/CONFIG.md and .orchestra/OBJECTIVE.md to your feature branch
  4. Run: .orchestra/runtime/bin/orchestra run
EOF
}
cmd_run() {
    local project_dir
    project_dir="$(git rev-parse --show-toplevel 2>/dev/null)" || die "Not in a git repository"
    local orch="$project_dir/.orchestra"
    [ -d "$orch" ] || die ".orchestra/ not found. Run 'orchestra init' first."

    # Load + validate config (sourced from RUNTIME copy, not source-tree)
    declare -gA ORCHESTRA_CONFIG
    # shellcheck source=/dev/null
    source "$orch/runtime/lib/config.sh"
    parse_config_md "$orch/CONFIG.md" || die "CONFIG.md parse failed"
    apply_config_defaults
    validate_config || die "CONFIG.md validation failed"

    local tmux_prefix="${ORCHESTRA_CONFIG[TMUX_PREFIX]}"

    # ============================================================
    # PREFLIGHT — per spec § 3.4. Run in this order; first failure
    # exits non-zero with a specific cleanup recipe.
    # (validate_config above already rejected obsolete BASE_BRANCH /
    # WORKTREE_BASE keys.)
    # ============================================================

    # Preflight 1: Branch refusal. Hardcoded refusal on main/master,
    # plus any entry in PROTECTED_BRANCHES.
    local current_branch
    current_branch="$(git -C "$project_dir" branch --show-current)"
    [ -n "$current_branch" ] || die "could not determine current branch (detached HEAD?)"

    local protected_csv="${ORCHESTRA_CONFIG[PROTECTED_BRANCHES]:-main,master}"
    local -a protected_branches=(main master)
    local _IFS_save="$IFS"
    IFS=','
    # shellcheck disable=SC2206
    local -a _csv_parts=($protected_csv)
    IFS="$_IFS_save"
    local b
    for b in "${_csv_parts[@]}"; do
        [ -n "$b" ] && protected_branches+=("$b")
    done

    for b in "${protected_branches[@]}"; do
        if [ "$current_branch" = "$b" ]; then
            die "Refusing to run on protected branch '$current_branch'.
Orchestra in run-in-place mode commits directly on HEAD. Running on
'main' or any PROTECTED_BRANCHES entry would commit autonomously to a
protected branch.
Switch to a feature branch first:
  git checkout -b feature/<your-slug>
Or, if you want a different protected set, edit PROTECTED_BRANCHES in
.orchestra/CONFIG.md."
        fi
    done

    # Preflight 2: WORKTREE_PATH canary — catches inherited CONFIG.md
    # from a sibling worktree. Compare resolved paths.
    local declared_wt actual_wt
    declared_wt="$(realpath "${ORCHESTRA_CONFIG[WORKTREE_PATH]}" 2>/dev/null || echo "")"
    actual_wt="$(realpath "$project_dir")"
    [ -n "$declared_wt" ] || die "WORKTREE_PATH in CONFIG.md is empty or does not resolve."
    if [ "$declared_wt" != "$actual_wt" ]; then
        die "WORKTREE_PATH canary mismatch.
  CONFIG.md says: $declared_wt
  Actual repo:    $actual_wt
Likely cause: this .orchestra/CONFIG.md was inherited from a sibling
worktree without updating WORKTREE_PATH.
Fix: edit .orchestra/CONFIG.md and set WORKTREE_PATH to this worktree's
absolute path ($actual_wt), then re-run."
    fi

    # Preflight 3: No prior non-archive run folder. Leftover from a
    # crashed run, or a concurrent run from another tmux session.
    local pre_existing
    pre_existing=$(find "$orch/runs" -mindepth 1 -maxdepth 1 -type d -not -name archive 2>/dev/null || true)
    if [ -n "$pre_existing" ]; then
        die "A previous run folder still exists under .orchestra/runs/:
$pre_existing

Review the folder for unarchived work, then archive it via
'orchestra reset' (moves to .orchestra/runs/archive/<ts>/) or remove
it manually before starting a new run."
    fi

    # ============================================================
    # End preflight. Allocate run folder + launch.
    # ============================================================

    # Atomic mkdir gate (spec Section 7) — retry up to 3x with fresh timestamp.
    # Belt-and-braces against sub-second clock anomalies; the no-prior-run-folder
    # preflight above already ensures the parent state is clean.
    local run_ts run_dir attempt=0
    local run_folder_root="$orch/runs"
    while [ $attempt -lt 3 ]; do
        run_ts="$(date -u +%Y%m%d-%H%M%S)"
        run_dir="$run_folder_root/$run_ts"
        if mkdir "$run_dir" 2>/dev/null; then
            break
        fi
        attempt=$((attempt + 1))
        sleep 1
    done
    [ $attempt -lt 3 ] || die "Could not allocate a unique run timestamp after 3 attempts"

    # Run-in-place: worktree IS the project dir; no separate run-branch.
    local worktree_dir="$project_dir"
    local tmux_name="$tmux_prefix-$run_ts"

    # Setup-cleanup trap — clears the run folder if anything below fails before
    # the session loop is live (spec Section 7). ERR only — EXIT/INT/TERM are
    # reserved for the wind-down lock trap (Section 6.1).
    trap "rm -rf '$run_dir'" ERR

    # Preflight: OBJECTIVE.md must exist in the worktree (per spec Section 4)
    [ -f "$orch/OBJECTIVE.md" ] \
        || die "OBJECTIVE.md not found in .orchestra/ — commit it to your feature branch and retry."

    # Build the run folder directly at <project>/.orchestra/runs/<ts>/.
    # The 3-TODO.md / 4-DECISIONS.md / 5-CHANGELOG.md files are NOT created
    # in parcel-mode (the working sessions write Governance/pending/<hex>.md
    # directly per spec § 3.6). Legacy-mode (project lacks Governance/CLAUDE.md
    # + Governance/pending/) still gets 3/4/5 for the wind-down's compat path.
    mkdir -p "$run_dir/9-sessions"
    # Activity log for Executor dispatches — the Organiser appends one
    # CSV line per Agent dispatch (timestamp,session,task,model,outcome,duration).
    : > "$run_dir/9-sessions/executor-activity.log"
    cp "$orch/OBJECTIVE.md" "$run_dir/2-OBJECTIVE.md"
    : > "$run_dir/1-INBOX.md"
    : > "$run_dir/6-HANDOVER.md"
    : > "$run_dir/7-SUMMARY.md"

    # Legacy-mode (no Governance/CLAUDE.md + Governance/pending/) keeps 3/4/5
    # so the wind-down's legacy Step 2 (append to parent files) has source files.
    if [ ! -d "$project_dir/Governance/pending" ] || [ ! -f "$project_dir/Governance/CLAUDE.md" ]; then
        : > "$run_dir/3-TODO.md"
        : > "$run_dir/4-DECISIONS.md"
        : > "$run_dir/5-CHANGELOG.md"
    fi

    # Tmux conflict check
    if tmux has-session -t "$tmux_name" 2>/dev/null; then
        die "tmux session '$tmux_name' already exists — kill it or wait"
    fi

    # Clear setup trap — past this point the run folder legitimately persists
    trap - ERR

    # Launch
    echo "Starting orchestra run in tmux session '$tmux_name'..."
    echo "  Worktree: $worktree_dir"
    echo "  Run dir:  $run_dir"
    echo "  Attach:   tmux attach -t $tmux_name"

    # Use tmux -e for env passing and -c for cwd to avoid building a shell
    # command-string with interpolated quotes (no injection vector even if
    # config values contain shell metacharacters).
    tmux new-session -d -s "$tmux_name" -c "$worktree_dir" \
        -e "RUN_DIR=$run_dir" \
        -e "WORKTREE_DIR=$worktree_dir" \
        -e "PROJECT_DIR=$project_dir" \
        -e "RUN_TS=$run_ts" \
        bash "$orch/runtime/bin/orchestrator.sh"
}
cmd_status() {
    local project_dir
    project_dir="$(git rev-parse --show-toplevel 2>/dev/null)" || die "Not in a git repository"
    local orch="$project_dir/.orchestra"
    [ -d "$orch" ] || die ".orchestra/ not found. Run 'orchestra init' first."

    declare -gA ORCHESTRA_CONFIG
    # shellcheck source=/dev/null
    source "$orch/runtime/lib/config.sh"
    parse_config_md "$orch/CONFIG.md" || die "CONFIG.md parse failed"
    apply_config_defaults

    local tmux_prefix="${ORCHESTRA_CONFIG[TMUX_PREFIX]}"

    echo "Active runs:"

    # In run-in-place, the run folder IS at <project>/.orchestra/runs/<ts>/
    # (no separate worktree-side copy). Iterate those directly.
    local run_dirs
    run_dirs=$(find "$orch/runs" -mindepth 1 -maxdepth 1 -type d -not -name archive 2>/dev/null | sort)

    local printed_any=0
    if [ -n "$run_dirs" ]; then
        local run
        while IFS= read -r run; do
            [ -n "$run" ] || continue
            local run_ts
            run_ts="$(basename "$run")"
            local tmux_name="$tmux_prefix-$run_ts"
            local state

            # Marker presence is authoritative — checked BEFORE tmux liveness.
            if [ -f "$run/BLOCKED" ]; then
                state="BLOCKED"
            elif [ -f "$run/WIND-DOWN-FAILED" ]; then
                state="WIND-DOWN-FAILED"
            elif tmux has-session -t "$tmux_name" 2>/dev/null; then
                state="active (tmux: $tmux_name)"
            else
                state="stale"
            fi

            echo "  $run_ts: $state"
            printed_any=1
        done <<< "$run_dirs"
    fi

    if [ "$printed_any" -eq 0 ]; then
        echo "  (no active runs)"
    fi

    # Count archived runs.
    local archived_count=0
    if [ -d "$orch/runs/archive" ]; then
        archived_count=$(find "$orch/runs/archive" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    fi
    echo ""
    echo "Archived runs: $archived_count"
}

smoke_assert_common() {
    local tmpdir="$1"
    local archive

    # Run-in-place path layout (depths measured from $tmpdir):
    #   .orchestra/runs                 = depth 2
    #   .orchestra/runs/<ts>            = depth 3   (active)
    #   .orchestra/runs/archive         = depth 3
    #   .orchestra/runs/archive/<ts>    = depth 4   (archived)
    archive=$(find "$tmpdir"/.orchestra/runs/archive -mindepth 1 -maxdepth 1 -type d -print -quit 2>/dev/null)
    [ -n "$archive" ] || die "ASSERT FAIL: no archived run found at .orchestra/runs/archive/"

    # Common files (parcel-mode skips 3/4/5; the smoke fixtures may be either mode).
    for f in 1-INBOX.md 2-OBJECTIVE.md 6-HANDOVER.md 7-SUMMARY.md 9-sessions; do
        [ -e "$archive/$f" ] || die "ASSERT FAIL: missing $f in archive"
    done

    # Active run dirs would be non-archive subfolders directly under .orchestra/runs/.
    # On a successful wind-down, the run dir was moved to archive/<ts>, so this
    # count must be 0.
    local active_count
    active_count=$(find "$tmpdir"/.orchestra/runs -mindepth 1 -maxdepth 1 -type d -not -name archive 2>/dev/null | wc -l)
    [ "$active_count" -eq 0 ] || die "ASSERT FAIL: active run folder remains (should be archived)"
}

smoke_assert_empty() {
    local tmpdir="$1"
    local wt
    wt=$(ls -d "$tmpdir"/wt/run-* | head -1)

    local found
    found=$(find "$wt" -maxdepth 1 \( -name 'TODO*' -o -name 'DECISIONS*' -o -name 'CHANGELOG*' \) | wc -l)
    [ "$found" -eq 0 ] || die "ASSERT FAIL: empty fixture should not have parent governance"

    [ "$(cat "$wt/file-a.txt" 2>/dev/null)" = "alpha" ] || die "ASSERT FAIL: file-a.txt"
    [ "$(cat "$wt/file-b.txt" 2>/dev/null)" = "beta" ] || die "ASSERT FAIL: file-b.txt"
}

smoke_assert_with_governance() {
    local tmpdir="$1"
    local wt
    # Pick the (single) worktree directly with find — no glob/ls/pipefail trap.
    wt=$(find "$tmpdir/wt" -mindepth 1 -maxdepth 1 -type d -name 'run-*' -print -quit 2>/dev/null)
    [ -n "$wt" ] || die "ASSERT FAIL: no worktree found"

    # Each parent file: original [fixture-original] entry preserved + correct marker present
    grep -q '\[fixture-original\] T001' "$wt/TODO.md"     || die "ASSERT FAIL: TODO.md original lost"
    grep -q '\[smoke-todo\]'              "$wt/TODO.md"     || die "ASSERT FAIL: TODO.md missing [smoke-todo] marker"

    grep -q '\[fixture-original\] D001' "$wt/DECISIONS.md" || die "ASSERT FAIL: DECISIONS.md original lost"
    grep -q '\[smoke-decision\]'          "$wt/DECISIONS.md" || die "ASSERT FAIL: DECISIONS.md missing [smoke-decision] marker"

    grep -q '\[fixture-original\] C001' "$wt/CHANGELOG.md" || die "ASSERT FAIL: CHANGELOG.md original lost"
    grep -q '\[smoke-changelog\]'         "$wt/CHANGELOG.md" || die "ASSERT FAIL: CHANGELOG.md missing [smoke-changelog] marker"

    # No marker leaked into the wrong file.
    ! grep -q '\[smoke-decision\]'  "$wt/TODO.md"      || die "ASSERT FAIL: [smoke-decision] leaked into TODO.md"
    ! grep -q '\[smoke-changelog\]' "$wt/TODO.md"      || die "ASSERT FAIL: [smoke-changelog] leaked into TODO.md"
    ! grep -q '\[smoke-todo\]'      "$wt/DECISIONS.md" || die "ASSERT FAIL: [smoke-todo] leaked into DECISIONS.md"
    ! grep -q '\[smoke-changelog\]' "$wt/DECISIONS.md" || die "ASSERT FAIL: [smoke-changelog] leaked into DECISIONS.md"
    ! grep -q '\[smoke-todo\]'      "$wt/CHANGELOG.md" || die "ASSERT FAIL: [smoke-todo] leaked into CHANGELOG.md"
    ! grep -q '\[smoke-decision\]'  "$wt/CHANGELOG.md" || die "ASSERT FAIL: [smoke-decision] leaked into CHANGELOG.md"

    # Wind-down per-file commits visible on the merged base branch. Use literal
    # arrow U+2192 to match the prompt's commit-message convention.
    (
        cd "$wt"
        git log --grep "wind-down: ingest 3-TODO.md →"      --format=%H | grep -q . || die "ASSERT FAIL: missing TODO ingest commit"
        git log --grep "wind-down: ingest 4-DECISIONS.md →" --format=%H | grep -q . || die "ASSERT FAIL: missing DECISIONS ingest commit"
        git log --grep "wind-down: ingest 5-CHANGELOG.md →" --format=%H | grep -q . || die "ASSERT FAIL: missing CHANGELOG ingest commit"
    )

    # Work products from the OBJECTIVE.
    [ "$(cat "$wt/file-a.txt" 2>/dev/null)" = "alpha" ] || die "ASSERT FAIL: file-a.txt"
    [ "$(cat "$wt/file-b.txt" 2>/dev/null)" = "beta" ]  || die "ASSERT FAIL: file-b.txt"
}

smoke_assert_with_parcel() {
    local tmpdir="$1"
    local wt archive
    wt=$(find "$tmpdir/wt" -mindepth 1 -maxdepth 1 -type d -name 'run-*' -print -quit 2>/dev/null)
    [ -n "$wt" ] || die "ASSERT FAIL: no worktree found"

    archive=$(find "$tmpdir/wt" -mindepth 5 -maxdepth 5 -type d -path '*/runs/archive/*' -print -quit 2>/dev/null)
    [ -n "$archive" ] || die "ASSERT FAIL: no archived run found"

    # (a) At least one parcel file exists at Governance/pending/<hex>.md.
    local parcel_count
    parcel_count=$(find "$wt/Governance/pending" -mindepth 1 -maxdepth 1 -type f -name '*.md' -not -name '.gitkeep' 2>/dev/null | wc -l)
    [ "$parcel_count" -ge 1 ] || die "ASSERT FAIL: no parcel created in Governance/pending/ (parcel-mode wind-down should have converted run governance)"

    # (b) Parcel-conversion commit landed on the merged base.
    (
        cd "$wt"
        git log --grep "wind-down: convert run governance to parcels" --format=%H | grep -q . \
            || die "ASSERT FAIL: missing 'wind-down: convert run governance to parcels' commit"
    )

    # (c) 7-SUMMARY.md has a Parcel conversion subsection (per Step 2e parcel-mode schema).
    local summary="$archive/7-SUMMARY.md"
    grep -q "Parcel conversion" "$summary" \
        || die "ASSERT FAIL: 7-SUMMARY.md missing 'Parcel conversion' subsection"

    # (d) Parent project's TODO/DECISIONS/CHANGELOG must NOT have been edited.
    # The fixture-original entries should still be the only content (plus the trailing newline).
    grep -q '\[fixture-original\] T001' "$wt/TODO.md" \
        || die "ASSERT FAIL: TODO.md original lost"
    ! grep -q '\[smoke-todo\]' "$wt/TODO.md" \
        || die "ASSERT FAIL: parcel-mode wind-down must NOT edit TODO.md (smoke-todo marker leaked into parent file)"

    grep -q '\[fixture-original\] D001' "$wt/DECISIONS.md" \
        || die "ASSERT FAIL: DECISIONS.md original lost"
    ! grep -q '\[smoke-decision\]' "$wt/DECISIONS.md" \
        || die "ASSERT FAIL: parcel-mode wind-down must NOT edit DECISIONS.md (smoke-decision marker leaked into parent file)"

    grep -q '\[fixture-original\] C001' "$wt/CHANGELOG.md" \
        || die "ASSERT FAIL: CHANGELOG.md original lost"
    ! grep -q '\[smoke-changelog\]' "$wt/CHANGELOG.md" \
        || die "ASSERT FAIL: parcel-mode wind-down must NOT edit CHANGELOG.md (smoke-changelog marker leaked into parent file)"

    # (e) The legacy ingest commits must NOT exist — parcel mode replaces them.
    (
        cd "$wt"
        ! git log --grep "wind-down: ingest 3-TODO.md →" --format=%H | grep -q . \
            || die "ASSERT FAIL: legacy 'wind-down: ingest 3-TODO.md' commit present in parcel-mode run"
        ! git log --grep "wind-down: ingest 4-DECISIONS.md →" --format=%H | grep -q . \
            || die "ASSERT FAIL: legacy 'wind-down: ingest 4-DECISIONS.md' commit present in parcel-mode run"
        ! git log --grep "wind-down: ingest 5-CHANGELOG.md →" --format=%H | grep -q . \
            || die "ASSERT FAIL: legacy 'wind-down: ingest 5-CHANGELOG.md' commit present in parcel-mode run"
    )

    # (f) Parcel contains the structural section headings — wind-down folded
    # 3-TODO/4-DECISIONS/5-CHANGELOG content into the right section types.
    # We don't assert verbatim marker preservation; the wind-down agent is
    # expected to paraphrase/restructure run governance into the parcel format,
    # not copy markers byte-for-byte.
    local parcel
    parcel=$(find "$wt/Governance/pending" -mindepth 1 -maxdepth 1 -type f -name '*.md' -not -name '.gitkeep' -print -quit)
    grep -qE '^## Task' "$parcel" \
        || die "ASSERT FAIL: parcel missing '## Task' section (3-TODO content not folded in)"
    grep -qE '^## Decisions' "$parcel" \
        || die "ASSERT FAIL: parcel missing '## Decisions' section (4-DECISIONS content not folded in)"
    grep -qE '^## Changelog' "$parcel" \
        || die "ASSERT FAIL: parcel missing '## Changelog' section (5-CHANGELOG content not folded in)"
    # Frontmatter present.
    head -1 "$parcel" | grep -qE '^---' \
        || die "ASSERT FAIL: parcel missing frontmatter (first line should be ---)"
    grep -qE '^hex: [0-9a-f]{6}$' "$parcel" \
        || die "ASSERT FAIL: parcel frontmatter missing 'hex: <6-hex>' field"

    # Work product from the OBJECTIVE.
    [ "$(cat "$wt/file-a.txt" 2>/dev/null)" = "alpha" ] || die "ASSERT FAIL: file-a.txt"
}

smoke_assert_with_conflict() {
    local tmpdir="$1"
    local wt archive
    wt=$(find "$tmpdir/wt" -mindepth 1 -maxdepth 1 -type d -name 'run-*' -print -quit 2>/dev/null)
    [ -n "$wt" ] || die "ASSERT FAIL: no worktree found"

    # 7-SUMMARY.md lives in the archived run folder. smoke_assert_common
    # already verified its existence; re-locate here.
    archive=$(find "$tmpdir/wt" -mindepth 5 -maxdepth 5 -type d -path '*/runs/archive/*' -print -quit 2>/dev/null)
    [ -n "$archive" ] || die "ASSERT FAIL: no archived run found"

    # Conflict surfaced in 7-SUMMARY.md per spec Section 6.3 step 4a schema.
    local summary="$archive/7-SUMMARY.md"
    grep -q "Potential governance conflicts" "$summary" \
        || die "ASSERT FAIL: 7-SUMMARY.md missing 'Potential governance conflicts' subsection"
    grep -qE '###[[:space:]]+Conflict' "$summary" \
        || die "ASSERT FAIL: 7-SUMMARY.md has no '### Conflict' entry"
    grep -qE 'Source:.*4-DECISIONS' "$summary" \
        || die "ASSERT FAIL: conflict Source not labelled 4-DECISIONS.md"
    grep -qE 'Target:.*DECISIONS\.md' "$summary" \
        || die "ASSERT FAIL: conflict Target not labelled DECISIONS.md"

    # Append-only invariant: original SQLite decision still present, new
    # Postgres decision appended.
    grep -q '\[fixture-original\] D001.*SQLite' "$wt/DECISIONS.md" \
        || die "ASSERT FAIL: original [fixture-original] D001 (SQLite) lost from DECISIONS.md"
    grep -qE '\[smoke-decision\].*Postgres' "$wt/DECISIONS.md" \
        || die "ASSERT FAIL: new [smoke-decision] (Postgres) missing from DECISIONS.md"

    # Wind-down ingestion commit for DECISIONS still landed on the base.
    (
        cd "$wt"
        git log --grep "wind-down: ingest 4-DECISIONS.md →" --format=%H | grep -q . \
            || die "ASSERT FAIL: missing DECISIONS ingest commit"
    )
}

smoke_assert_with_handover() {
    local tmpdir="$1"
    local wt archive
    wt=$(find "$tmpdir/wt" -mindepth 1 -maxdepth 1 -type d -name 'run-*' -print -quit 2>/dev/null)
    [ -n "$wt" ] || die "ASSERT FAIL: no worktree found"

    archive=$(find "$tmpdir/wt" -mindepth 5 -maxdepth 5 -type d -path '*/runs/archive/*' -print -quit 2>/dev/null)
    [ -n "$archive" ] || die "ASSERT FAIL: no archived run found"

    # (a) Exactly 2 session transcripts — Phase 1 (Session 1) + Phase 2 (Session 2).
    # Match `[0-9]*.json` to count numbered transcripts only, excluding summary.json.
    local session_count
    session_count=$(find "$archive/9-sessions" -mindepth 1 -maxdepth 1 -name '[0-9]*.json' 2>/dev/null | wc -l)
    [ "$session_count" -eq 2 ] || die "ASSERT FAIL: expected 2 sessions (HANDOVER then COMPLETE), got $session_count"

    # (b) Final 6-HANDOVER.md may be empty (post-COMPLETE), so check the per-session
    # exit signals instead — Session 1 must have HANDOVER and Session 2 COMPLETE.
    # Both live in 9-sessions/summary.json (a JSON array, one entry per session).
    local s1_signal s2_signal
    s1_signal=$(jq -r '.[0].exit_signal // empty' "$archive/9-sessions/summary.json" 2>/dev/null)
    s2_signal=$(jq -r '.[1].exit_signal // empty' "$archive/9-sessions/summary.json" 2>/dev/null)
    [ "$s1_signal" = "HANDOVER" ] || die "ASSERT FAIL: session 001 exit_signal expected HANDOVER, got '${s1_signal:-<unset>}'"
    [ "$s2_signal" = "COMPLETE" ] || die "ASSERT FAIL: session 002 exit_signal expected COMPLETE, got '${s2_signal:-<unset>}'"

    # (c) Both work products on the merged base.
    [ "$(cat "$wt/file-a.txt" 2>/dev/null)" = "alpha" ] || die "ASSERT FAIL: file-a.txt"
    [ "$(cat "$wt/file-b.txt" 2>/dev/null)" = "beta" ]  || die "ASSERT FAIL: file-b.txt"

    # (d) Both phase markers landed in the parent governance files (legacy ingestion).
    grep -q 'Phase 1 done' "$wt/TODO.md" || die "ASSERT FAIL: TODO.md missing Phase 1 marker"
    grep -q 'Phase 2 done' "$wt/TODO.md" || die "ASSERT FAIL: TODO.md missing Phase 2 marker (Session 2 work didn't land)"
    grep -q 'alpha' "$wt/CHANGELOG.md"   || die "ASSERT FAIL: CHANGELOG.md missing Phase 1 entry"
    grep -q 'beta'  "$wt/CHANGELOG.md"   || die "ASSERT FAIL: CHANGELOG.md missing Phase 2 entry (Session 2 work didn't land)"

    # (e) Wind-down ingest commits visible (legacy mode).
    (
        cd "$wt"
        git log --grep "wind-down: ingest 3-TODO.md →"      --format=%H | grep -q . || die "ASSERT FAIL: missing TODO ingest commit"
        git log --grep "wind-down: ingest 4-DECISIONS.md →" --format=%H | grep -q . || die "ASSERT FAIL: missing DECISIONS ingest commit"
        git log --grep "wind-down: ingest 5-CHANGELOG.md →" --format=%H | grep -q . || die "ASSERT FAIL: missing CHANGELOG ingest commit"
    )

    # (f) Originals preserved.
    grep -q '\[fixture-original\] T001' "$wt/TODO.md"      || die "ASSERT FAIL: TODO.md original lost"
    grep -q '\[fixture-original\] D001' "$wt/DECISIONS.md" || die "ASSERT FAIL: DECISIONS.md original lost"
    grep -q '\[fixture-original\] C001' "$wt/CHANGELOG.md" || die "ASSERT FAIL: CHANGELOG.md original lost"
}

smoke_assert_with_organiser() {
    local tmpdir="$1"
    local wt archive
    wt=$(find "$tmpdir/wt" -mindepth 1 -maxdepth 1 -type d -name 'run-*' -print -quit 2>/dev/null)
    [ -n "$wt" ] || die "ASSERT FAIL: no worktree found"

    archive=$(find "$tmpdir/wt" -mindepth 5 -maxdepth 5 -type d -path '*/runs/archive/*' -print -quit 2>/dev/null)
    [ -n "$archive" ] || die "ASSERT FAIL: no archived run found"

    # (a) Single working session ran to COMPLETE.
    local session_count
    session_count=$(find "$archive/9-sessions" -mindepth 1 -maxdepth 1 -name '[0-9]*.json' 2>/dev/null | wc -l)
    [ "$session_count" -eq 1 ] || die "ASSERT FAIL: expected exactly 1 session transcript, got $session_count"

    local s1_signal
    s1_signal=$(jq -r '.[0].exit_signal // empty' "$archive/9-sessions/summary.json" 2>/dev/null)
    [ "$s1_signal" = "COMPLETE" ] || die "ASSERT FAIL: session 001 exit_signal expected COMPLETE, got '${s1_signal:-<unset>}'"

    # (b) Activity log exists with exactly one non-empty CSV entry naming
    # model=sonnet and outcome=DONE.
    local activity_log="$archive/9-sessions/executor-activity.log"
    [ -f "$activity_log" ] || die "ASSERT FAIL: 9-sessions/executor-activity.log missing"
    local activity_lines
    activity_lines=$(grep -c '[^[:space:]]' "$activity_log" 2>/dev/null) || activity_lines=0
    [ "$activity_lines" -eq 1 ] || die "ASSERT FAIL: expected 1 entry in executor-activity.log, got $activity_lines"
    grep -q ',sonnet,DONE,' "$activity_log" \
        || die "ASSERT FAIL: executor-activity.log entry must include ',sonnet,DONE,' — got: $(cat "$activity_log")"

    # (c) Session transcript records an Agent tool dispatch (proves the
    # Organiser used the Agent tool, not a direct Write).
    grep -q '"name":"Agent"' "$archive/9-sessions/001.json" \
        || die "ASSERT FAIL: session 001 transcript has no Agent tool_use event"

    # (d) Work product on the merged base, with exact content.
    [ -f "$wt/file-executor.txt" ] || die "ASSERT FAIL: file-executor.txt missing on merged base"
    local content
    content=$(cat "$wt/file-executor.txt")
    [ "$content" = "executor wrote this" ] \
        || die "ASSERT FAIL: file-executor.txt content expected 'executor wrote this', got '$content'"

    # (e) Governance markers landed (legacy ingestion).
    grep -q 'Dispatch test complete' "$wt/TODO.md"        || die "ASSERT FAIL: TODO.md missing dispatch marker"
    grep -q 'Used Agent tool'        "$wt/DECISIONS.md"   || die "ASSERT FAIL: DECISIONS.md missing dispatch decision"
    grep -q 'via Sonnet Executor'    "$wt/CHANGELOG.md"   || die "ASSERT FAIL: CHANGELOG.md missing dispatch entry"

    # (f) Originals preserved.
    grep -q '\[fixture-original\] T001' "$wt/TODO.md"      || die "ASSERT FAIL: TODO.md original lost"
    grep -q '\[fixture-original\] D001' "$wt/DECISIONS.md" || die "ASSERT FAIL: DECISIONS.md original lost"
    grep -q '\[fixture-original\] C001' "$wt/CHANGELOG.md" || die "ASSERT FAIL: CHANGELOG.md original lost"
}

smoke_assert_with_escalation() {
    local tmpdir="$1"
    local wt archive
    wt=$(find "$tmpdir/wt" -mindepth 1 -maxdepth 1 -type d -name 'run-*' -print -quit 2>/dev/null)
    [ -n "$wt" ] || die "ASSERT FAIL: no worktree found"

    archive=$(find "$tmpdir/wt" -mindepth 5 -maxdepth 5 -type d -path '*/runs/archive/*' -print -quit 2>/dev/null)
    [ -n "$archive" ] || die "ASSERT FAIL: no archived run found"

    local session_count s1_signal
    session_count=$(find "$archive/9-sessions" -mindepth 1 -maxdepth 1 -name '[0-9]*.json' 2>/dev/null | wc -l)
    [ "$session_count" -eq 1 ] || die "ASSERT FAIL: expected exactly 1 session transcript, got $session_count"
    s1_signal=$(jq -r '.[0].exit_signal // empty' "$archive/9-sessions/summary.json" 2>/dev/null)
    [ "$s1_signal" = "COMPLETE" ] || die "ASSERT FAIL: session 001 exit_signal expected COMPLETE, got '${s1_signal:-<unset>}'"

    # Activity log: exactly 2 entries, both with task-id smoke-T1.
    # First sonnet,ESCALATE; second opus,DONE.
    local activity_log="$archive/9-sessions/executor-activity.log"
    [ -f "$activity_log" ] || die "ASSERT FAIL: activity log missing"
    local n
    n=$(grep -c '[^[:space:]]' "$activity_log" 2>/dev/null) || n=0
    [ "$n" -eq 2 ] || die "ASSERT FAIL: expected 2 activity-log entries, got $n. File contents:\n$(cat "$activity_log")"

    local task_ids
    task_ids=$(awk -F, 'NF{print $3}' "$activity_log" | sort -u | wc -l)
    [ "$task_ids" -eq 1 ] || die "ASSERT FAIL: expected both activity-log entries to share one task-id, got $task_ids distinct"

    local line1 line2
    line1=$(awk 'NF{print; exit}' "$activity_log")
    line2=$(awk 'NF{print}' "$activity_log" | sed -n '2p')
    case "$line1" in
        *,smoke-T1,sonnet,ESCALATE,*) ;;
        *) die "ASSERT FAIL: first activity-log entry expected ',smoke-T1,sonnet,ESCALATE,'; got: $line1" ;;
    esac
    case "$line2" in
        *,smoke-T1,opus,DONE,*) ;;
        *) die "ASSERT FAIL: second activity-log entry expected ',smoke-T1,opus,DONE,'; got: $line2" ;;
    esac

    # Two Agent tool dispatches in the session transcript.
    local agent_count
    agent_count=$(grep -c '"name":"Agent"' "$archive/9-sessions/001.json" 2>/dev/null) || agent_count=0
    [ "$agent_count" -ge 2 ] || die "ASSERT FAIL: expected at least 2 Agent tool_use events in session 001 transcript, got $agent_count"

    # Work product on merged base.
    [ -f "$wt/escalation-result.txt" ] || die "ASSERT FAIL: escalation-result.txt missing on merged base"
    local content
    content=$(cat "$wt/escalation-result.txt")
    [ "$content" = "opus completed this" ] \
        || die "ASSERT FAIL: escalation-result.txt content expected 'opus completed this', got '$content'"

    # Governance + originals.
    grep -q 'Escalation retry test complete' "$wt/TODO.md"          || die "ASSERT FAIL: TODO.md missing escalation marker"
    grep -q 'reran on Opus'                  "$wt/DECISIONS.md"     || die "ASSERT FAIL: DECISIONS.md missing escalation rationale"
    grep -q 'Opus after Sonnet ESCALATE'     "$wt/CHANGELOG.md"     || die "ASSERT FAIL: CHANGELOG.md missing escalation entry"
    grep -q '\[fixture-original\] T001'      "$wt/TODO.md"          || die "ASSERT FAIL: TODO.md original lost"
    grep -q '\[fixture-original\] D001'      "$wt/DECISIONS.md"     || die "ASSERT FAIL: DECISIONS.md original lost"
    grep -q '\[fixture-original\] C001'      "$wt/CHANGELOG.md"     || die "ASSERT FAIL: CHANGELOG.md original lost"
}

smoke_assert_with_verify() {
    local tmpdir="$1"
    local wt archive
    wt=$(find "$tmpdir/wt" -mindepth 1 -maxdepth 1 -type d -name 'run-*' -print -quit 2>/dev/null)
    [ -n "$wt" ] || die "ASSERT FAIL: no worktree found"

    archive=$(find "$tmpdir/wt" -mindepth 5 -maxdepth 5 -type d -path '*/runs/archive/*' -print -quit 2>/dev/null)
    [ -n "$archive" ] || die "ASSERT FAIL: no archived run found"

    local session_count s1_signal
    session_count=$(find "$archive/9-sessions" -mindepth 1 -maxdepth 1 -name '[0-9]*.json' 2>/dev/null | wc -l)
    [ "$session_count" -eq 1 ] || die "ASSERT FAIL: expected exactly 1 session transcript, got $session_count"
    s1_signal=$(jq -r '.[0].exit_signal // empty' "$archive/9-sessions/summary.json" 2>/dev/null)
    [ "$s1_signal" = "COMPLETE" ] || die "ASSERT FAIL: session 001 exit_signal expected COMPLETE, got '${s1_signal:-<unset>}'"

    # Activity log: exactly 2 entries, both sonnet,DONE under one task-id.
    local activity_log="$archive/9-sessions/executor-activity.log"
    [ -f "$activity_log" ] || die "ASSERT FAIL: activity log missing"
    local n
    n=$(grep -c '[^[:space:]]' "$activity_log" 2>/dev/null) || n=0
    [ "$n" -eq 2 ] || die "ASSERT FAIL: expected 2 activity-log entries, got $n. File contents:\n$(cat "$activity_log")"

    local task_ids done_count
    task_ids=$(awk -F, 'NF{print $3}' "$activity_log" | sort -u | wc -l)
    done_count=$(grep -c ',sonnet,DONE,' "$activity_log") || done_count=0
    [ "$task_ids" -eq 1 ] || die "ASSERT FAIL: expected both activity-log entries to share one task-id, got $task_ids distinct"
    [ "$done_count" -eq 2 ] || die "ASSERT FAIL: expected 2 ',sonnet,DONE,' entries, got $done_count"

    # Two Agent tool dispatches in the session transcript.
    local agent_count
    agent_count=$(grep -c '"name":"Agent"' "$archive/9-sessions/001.json" 2>/dev/null) || agent_count=0
    [ "$agent_count" -ge 2 ] || die "ASSERT FAIL: expected at least 2 Agent tool_use events in session 001 transcript, got $agent_count"

    # Final work product (second-dispatch content) on merged base.
    [ -f "$wt/verify-result.txt" ] || die "ASSERT FAIL: verify-result.txt missing on merged base"
    local content
    content=$(cat "$wt/verify-result.txt")
    [ "$content" = "correct content" ] \
        || die "ASSERT FAIL: verify-result.txt content expected 'correct content', got '$content'"

    # Verification-rejection note must appear in DECISIONS.md (proves the
    # Organiser logged the rejection on the parent governance side).
    grep -q 'verification rejected' "$wt/DECISIONS.md" \
        || die "ASSERT FAIL: DECISIONS.md missing verification-rejection note"

    # Governance + originals.
    grep -q 'Verify-reject test complete' "$wt/TODO.md"      || die "ASSERT FAIL: TODO.md missing verify marker"
    grep -q 'fixed via second'            "$wt/CHANGELOG.md" || die "ASSERT FAIL: CHANGELOG.md missing fix entry"
    grep -q '\[fixture-original\] T001'   "$wt/TODO.md"      || die "ASSERT FAIL: TODO.md original lost"
    grep -q '\[fixture-original\] D001'   "$wt/DECISIONS.md" || die "ASSERT FAIL: DECISIONS.md original lost"
    grep -q '\[fixture-original\] C001'   "$wt/CHANGELOG.md" || die "ASSERT FAIL: CHANGELOG.md original lost"
}

cmd_test() {
    local variant="${1:-empty}"
    case "$variant" in
        empty|with-governance|with-conflict|with-parcel|with-handover|with-organiser|with-escalation|with-verify) ;;
        *) die "Unknown smoke-test variant: $variant (use 'empty', 'with-governance', 'with-conflict', 'with-parcel', 'with-handover', 'with-organiser', 'with-escalation', or 'with-verify')" ;;
    esac

    command -v claude >/dev/null 2>&1 \
        || die "claude CLI not found on PATH; smoke test needs real Claude"

    local fixture="$SCRIPT_DIR/../examples/smoke-test/$variant"
    [ -d "$fixture" ] || die "Fixture not found: $fixture"

    local tmpdir
    tmpdir="${TMPDIR:-/tmp}/orchestra-smoke-$(date -u +%Y%m%d-%H%M%S)-$variant"
    rm -rf "$tmpdir"
    mkdir -p "$tmpdir"
    cp -r "$fixture/." "$tmpdir/"

    cd "$tmpdir"
    git init -q
    # Run-in-place refuses on main/master; start on a feature branch.
    git checkout -b feature/smoke -q 2>/dev/null || git branch -m feature/smoke 2>/dev/null

    git -c user.email=smoke@test -c user.name=smoke add -A
    git -c user.email=smoke@test -c user.name=smoke commit -q -m "smoke-test fixture init"

    "$SCRIPT_DIR/orchestra" init . >/dev/null

    cat > .orchestra/CONFIG.md <<EOF
- \`MAX_SESSIONS\`: 2
- \`MAX_CONSECUTIVE_CRASHES\`: 1
- \`ORGANISER_MODEL\`: opus
- \`WORKTREE_PATH\`: $(realpath "$tmpdir")
- \`TMUX_PREFIX\`: orch-smoke
- \`SMOKE_TEST_TIMEOUT\`: 900
EOF

    cp OBJECTIVE.md .orchestra/OBJECTIVE.md

    git -c user.email=smoke@test -c user.name=smoke add -A
    git -c user.email=smoke@test -c user.name=smoke commit -q -m "smoke-test config + objective"

    .orchestra/runtime/bin/orchestra run

    # Poll for the run folder to appear at <tmpdir>/.orchestra/runs/<ts>/,
    # then wait for its tmux session to end.
    local elapsed=0 timeout=900 run_dir="" run_ts=""
    while [ $elapsed -lt $timeout ]; do
        if [ -z "$run_dir" ]; then
            run_dir=$(find "$tmpdir/.orchestra/runs" -mindepth 1 -maxdepth 1 -type d -not -name archive 2>/dev/null | head -1 || true)
            if [ -n "$run_dir" ]; then
                run_ts="$(basename "$run_dir")"
            else
                # Run may already be archived (fast paths).
                run_dir=$(find "$tmpdir/.orchestra/runs/archive" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1 || true)
                if [ -n "$run_dir" ]; then
                    run_ts="$(basename "$run_dir")"
                fi
            fi
        fi
        if [ -n "$run_ts" ]; then
            tmux has-session -t "orch-smoke-$run_ts" 2>/dev/null || break
        fi
        sleep 10
        elapsed=$((elapsed + 10))
    done

    if [ $elapsed -ge $timeout ]; then
        tmux kill-session -t "orch-smoke-$run_ts" 2>/dev/null || true
        die "Smoke test timed out after ${timeout}s"
    fi

    smoke_assert_common "$tmpdir"
    case "$variant" in
        empty)            smoke_assert_empty "$tmpdir" ;;
        with-governance)  smoke_assert_with_governance "$tmpdir" ;;
        with-conflict)    smoke_assert_with_conflict "$tmpdir" ;;
        with-parcel)      smoke_assert_with_parcel "$tmpdir" ;;
        with-handover)    smoke_assert_with_handover "$tmpdir" ;;
        with-organiser)   smoke_assert_with_organiser "$tmpdir" ;;
        with-escalation)  smoke_assert_with_escalation "$tmpdir" ;;
        with-verify)      smoke_assert_with_verify "$tmpdir" ;;
    esac

    echo ""
    echo "Smoke test PASSED ($variant). Tempdir: $tmpdir"
}

cmd_reset() {
    local project_dir
    project_dir="$(git rev-parse --show-toplevel 2>/dev/null)" || die "Not in a git repository"
    local orch="$project_dir/.orchestra"
    [ -d "$orch" ] || die ".orchestra/ not found. Run 'orchestra init' first."

    declare -gA ORCHESTRA_CONFIG
    # shellcheck source=/dev/null
    source "$orch/runtime/lib/config.sh"
    parse_config_md "$orch/CONFIG.md" || die "CONFIG.md parse failed"
    apply_config_defaults

    local archived=0

    # In run-in-place, run folders live at <project>/.orchestra/runs/<ts>/.
    # Archive any non-archive subfolder.
    local runs_dir="$orch/runs"
    if [ -d "$runs_dir" ]; then
        local active_runs
        active_runs=$(find "$runs_dir" -mindepth 1 -maxdepth 1 -type d -not -name archive 2>/dev/null)
        local run
        while IFS= read -r run; do
            [ -n "$run" ] || continue
            local run_ts
            run_ts="$(basename "$run")"
            mkdir -p "$runs_dir/archive"
            mv "$run" "$runs_dir/archive/$run_ts"
            archived=$((archived + 1))
        done <<< "$active_runs"
    fi

    # Wind-down lock lives at <project>/.orchestra/runs/.wind-down.lock.
    # Remove if stale; orchestrator's own liveness/start-time check catches
    # a still-running holder anyway.
    if [ -f "$orch/runs/.wind-down.lock" ]; then
        rm -f "$orch/runs/.wind-down.lock"
    fi

    echo "Reset: $archived run folder(s) archived."
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
    init)      cmd_init "$@" ;;
    run|start) cmd_run "$@" ;;
    status)    cmd_status "$@" ;;
    test)      cmd_test "$@" ;;
    reset)     cmd_reset "$@" ;;
    cold-store|coldstore|cold_store) cmd_cold_store "$@" ;;
    -h|--help|help|"") usage; exit 0 ;;
    *) echo "Unknown command: $cmd" >&2; usage >&2; exit 1 ;;
esac
